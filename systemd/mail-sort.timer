[Unit]
Description=Run the Jev mail sort every 5 minutes

[Timer]
# Wall-clock ticks: they keep firing however late the user manager starts and across suspend
# (OnBootSec missed a manager started after boot+2min, and then the timer never fired again).
OnCalendar=*:0/5
Persistent=true
AccuracySec=30s

[Install]
WantedBy=timers.target
